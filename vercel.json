{
  "builds": [
    { "src": "backend/server.py", "use": "@vercel/python" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "DB_NAME": "rentalflow"
  },
  "build": {
    "env": {
      "REACT_APP_BACKEND_URL": ""
    }
  }
}
